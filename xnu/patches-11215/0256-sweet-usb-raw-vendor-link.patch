+static const uint8_t ud_cfg_desc_raw[32] = {
+	9, 2, 32, 0, 1, 1, 0, 0x80, 250,                /* config: 1 interface, 500 mA */
+	9, 4, 0, 0, 2, 0xff, 0x42, 0x01, 5,             /* interface 0: vendor, Bergamota raw Ethernet, two bulk endpoints */
+	7, 5, 0x81, 0x02, 0x00, 0x02, 0,                /* ep 0x81 bulk IN, 512 */
+	7, 5, 0x01, 0x02, 0x00, 0x02, 0,                /* ep 0x01 bulk OUT, 512 */
+};
