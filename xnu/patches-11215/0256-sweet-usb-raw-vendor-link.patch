+/*
+ * sweetusbraw=1 (0256): the same Ethernet frames on two bulk endpoints of ONE vendor-specific interface (class 0xff,
+ * subclass 0x42 'B', protocol 1), PID 0x0002. No host has a driver for it, so nothing (Android's or Linux's cdc_ether, a
+ * tablet's Ethernet stack) takes the interface away from the web page, which claims it over WebUSB. Framing: one bulk
+ * transfer = one Ethernet frame, exactly the ECM data pipe; no notifications, no alternate setting, link up at
+ * SET_CONFIGURATION.
+ */
+static int ud_raw;
+static const uint8_t ud_dev_desc_raw[18] = {
+	18, 1, 0x00, 0x02, 0x00, 0x00, 0x00, 64,
