+/*
+ * 0280: halt the VBIF clients and wait for their acks before GX goes down (Linux a6xx_gmu_shutdown -> bus_halt =
+ * a6xx_bus_clear_pending_transactions, a630 has VBIF, not GBIF: XIN_HALT_CTRL0 = 0xf, poll CTRL1 for 0xf, then 0).
+ * We powered GX down with whatever the GPU still had in flight on the bus; collapsing a power domain under an open bus
+ * transaction is a classic Qualcomm full-SoC hang (no abort, no log). Lock held, GX on.
+ */
+static void
+gpu_vbif_halt(const char *why)
+{
+	static unsigned logged;
+	unsigned i;
+
+	gpu_w(A6XX_VBIF_XIN_HALT_CTRL0, VBIF_XIN_HALT_MASK);
+	for (i = 0; i < 2000; i++) {
+		if ((gpu_r(A6XX_VBIF_XIN_HALT_CTRL1) & VBIF_XIN_HALT_MASK) == VBIF_XIN_HALT_MASK) {
+			break;
+		}
+		delay(10);
+	}
+	if (i == 2000) {
+		printf("SWEET GPU: VBIF halt (%s): no ack after 20 ms (CTRL1 %#x)\n", why, gpu_r(A6XX_VBIF_XIN_HALT_CTRL1));
+	} else if (logged < 3) {
+		logged++;
+		printf("SWEET GPU: VBIF halt (%s): acked after %u us\n", why, i * 10);
+	}
+	gpu_w(A6XX_VBIF_XIN_HALT_CTRL0, 0);
+}
