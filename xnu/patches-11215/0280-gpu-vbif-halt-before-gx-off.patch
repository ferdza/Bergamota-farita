+#define A6XX_VBIF_XIN_HALT_CTRL1 0x3081
+#define VBIF_XIN_HALT_MASK      0xfu
 #define A630_GMU_CHIPID         0x06030100u     /* chip id 0x06030001, minor/patch packed as the GMU wants */
 
