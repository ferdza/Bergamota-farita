+/*
+ * Boost pulse for frame / animation bursts: the A75 goes to its touch floor now and keeps it for ms milliseconds, then
+ * gives it up like a touch boost. Lock free like sweet_input_boost(); callable from any thread (the sysctl below, or a
+ * later hook in the display path). Only governor v2 in gov mode acts on it.
+ */
+void sweet_cpufreq_boost(uint32_t ms);
+void
+sweet_cpufreq_boost(uint32_t ms)
+{
+	if (cf_mode != MODE_GOV || cf_gov_ver != 2 || ms == 0) {
+		return;
+	}
+	uint64_t hold, until, now = mach_absolute_time();
+	nanoseconds_to_absolutetime((uint64_t)MIN(ms, 2000u) * NSEC_PER_MSEC, &hold);
+	until = now + hold;
+	if (until > cf_pulse_until) {
+		cf_pulse_until = until;
+	}
+	cf_pulses++;
+	struct cf_domain *d = &cf_dom[1];
+	if (d->state == CF_APPLIED && cf_rd(d, CPUFREQ_PERF_STATE) < d->in_idx) {
+		cf_request(d, d->in_idx);
+	}
+}
