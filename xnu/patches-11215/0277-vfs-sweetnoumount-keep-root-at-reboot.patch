+	 */
+	static int sweet_noumount = -1;
+	if (sweet_noumount < 0) {
+		int v = 0;
+		sweet_noumount = (PE_parse_boot_argn("sweetnoumount", &v, sizeof(v)) && v == 1) ? 1 : 0;
+	}
+	if (!uip->u_only_non_system && sweet_noumount && (mp->mnt_flag & MNT_ROOTFS)) {
+		printf("unmount(0) %s: kept mounted (sweetnoumount=1), syncing\n", mntname);
+		mount_ref(mp, 0);
+		mount_iterdrop(mp);
+		(void)VFS_SYNC(mp, MNT_WAIT, vfs_context_current());
+		mount_drop(mp, 0);
+		printf("unmount(0) %s: synced\n", mntname);
