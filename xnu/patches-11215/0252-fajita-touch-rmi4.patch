+/* ------------------------------------------------------------------ fajita */
+/* Synaptics RMI4 (F01/F12) over the GENI SE, ported from the iOS-16 fajita port.
+ * Self-contained: it does its own GPIO/clock bring-up (two TLMM tiles) and uses
+ * only the shared touch_msg/touch_se_init/touch_report helpers. */
+
+static uint8_t f01_query, f01_cmd, f01_ctrl, f01_data;
+static uint8_t f12_query, f12_ctrl, f12_data;
+static char fj_product[12];
+static int fj_xraw = 1080, fj_yraw = 2340, fj_max_x, fj_max_y;
+
+static void
+fj_gpio(vm_offset_t base, unsigned pin, unsigned mux, unsigned pull,
+    unsigned drive, bool out, bool high)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(base, off);
+	if (out) {
+		touch_wr(base, TOUCH_GPIO_IO(pin),
+		    (touch_rd(base, TOUCH_GPIO_IO(pin)) & ~2u) | (high ? 2u : 0u));
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(base, off, cfg);
+}
+
+static bool
+fajita_clocks(void)
+{
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | FJ_VOTE_MASK);
+	uint32_t cfg = touch_rd(st.gcc, FJ_GCC_RCG + 4u);
+	cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;   /* XO parent, divide by 1 */
+	touch_wr(st.gcc, FJ_GCC_RCG + 4u, cfg);
+	touch_wr(st.gcc, FJ_GCC_RCG, touch_rd(st.gcc, FJ_GCC_RCG) | 0x3u);
+	if (!touch_wait_clear(st.gcc, FJ_GCC_RCG, 1u)) {
+		printf("SWEET TS: RCG update timeout (rcg=%#x)\n", touch_rd(st.gcc, FJ_GCC_RCG));
+		return false;
+	}
+	for (unsigned i = 0; i < 200; ++i) {
+		if (!(touch_rd(st.gcc, FJ_GCC_CBCR) & (1u << 31))) {
+			return true;
+		}
+		touch_wait(1);
+	}
+	printf("SWEET TS: SE clock still halted (cbcr=%#x)\n", touch_rd(st.gcc, FJ_GCC_CBCR));
+	return false;
+}
+
+/* RMI4 page-0, 1-byte addressing. touch_msg refuses a combined write+read, so
+ * latch the register pointer with one write then read in a second transaction;
+ * RMI4 keeps the pointer between transactions. */
+static int
+rmi_read(uint8_t reg, uint8_t *buf, unsigned len)
+{
+	int err = touch_msg(FJ_TS_ADDR, &reg, 1, NULL, 0, false);
+	if (err) {
+		return err;
+	}
+	return touch_msg(FJ_TS_ADDR, NULL, 0, buf, len, false);
+}
+
+static int
+rmi_write(uint8_t reg, uint8_t val)
+{
+	uint8_t tx[2] = { reg, val };
+	return touch_msg(FJ_TS_ADDR, tx, 2, NULL, 0, false);
+}
+
+/* The PDT is a chain of 6-byte entries descending from 0xE9; the last byte is
+ * the function number and 0 ends the list. This panel answers F34/F01/F12. */
+static bool
+rmi_pdt(void)
+{
+	uint8_t buf[6];
+
+	f01_query = f01_cmd = f01_ctrl = f01_data = 0;
+	f12_query = f12_ctrl = f12_data = 0;
+	for (int a = 0x00e9; a > 6; a -= 6) {
+		if (rmi_read((uint8_t)a, buf, sizeof(buf)) != 0) {
+			printf("SWEET TS: PDT read %#x failed\n", a);
+			return false;
+		}
+		if (buf[5] == 0x00) {
+			break;
+		}
+		if (buf[5] == 0x01) {
+			f01_query = buf[0];
+			f01_cmd = buf[1];
+			f01_ctrl = buf[2];
+			f01_data = buf[3];
+		} else if (buf[5] == 0x12) {
+			f12_query = buf[0];
+			f12_ctrl = buf[2];
+			f12_data = buf[3];
+		}
+	}
+	if (f01_data == 0 || f12_data == 0) {
+		printf("SWEET TS: no F01/F12 in the PDT (f01=%#x f12=%#x)\n", f01_data, f12_data);
+		return false;
+	}
+	return true;
+}
+
+static bool
+rmi_f01_init(void)
+{
+	uint8_t id[11] = {0};
+
+	if (rmi_write(f01_cmd, 0x01) == 0) {          /* reset */
+		touch_wait(100);
+	}
+	if (rmi_read((uint8_t)(f01_query + 0x10u), id, 10) == 0) {
+		for (unsigned k = 0; k < 10; ++k) {
+			fj_product[k] = (char)id[k];
+		}
+		fj_product[10] = 0;
+		for (int i = 9; i >= 0 && fj_product[i] == ' '; --i) {
+			fj_product[i] = 0;
+		}
+		printf("SWEET TS: product id \"%s\"\n", fj_product);
+	}
+	if (rmi_write(f01_ctrl, 0x84) != 0 || rmi_write((uint8_t)(f01_ctrl + 1u), 0x7f) != 0) {
+		printf("SWEET TS: F01 control write failed\n");
+		return false;
+	}
+	return true;
+}
+
+/* One F12 2D report: up to TOUCH_MAX objects of 8 bytes; object +0 is the finger
+ * status (0 = none), +1/+2 and +3/+4 are 12-bit x/y. */
+static bool
+rmi_frame(void)
+{
+	uint8_t d[8 * TOUCH_MAX];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+
+	if (rmi_read(f12_data, d, sizeof(d)) != 0) {
+		return false;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *o = d + i * 8u;
+		if (o[0] == 0) {
+			continue;
+		}
+		int rx = o[1] | ((o[2] & 0x0fu) << 8);
+		int ry = o[3] | ((o[4] & 0x0fu) << 8);
+		int px = (int)((int64_t)rx * tb->w / (fj_xraw > 0 ? fj_xraw : (int)tb->w));
+		int py = (int)((int64_t)ry * tb->h / (fj_yraw > 0 ? fj_yraw : (int)tb->h));
+		if (px < 0) { px = 0; }
+		if (px > (int)tb->w - 1) { px = (int)tb->w - 1; }
+		if (py < 0) { py = 0; }
+		if (py > (int)tb->h - 1) { py = (int)tb->h - 1; }
+		x[i] = px;
+		y[i] = py;
+		mask |= 1u << i;
+		if (rx > fj_max_x) { fj_max_x = rx; }
+		if (ry > fj_max_y) { fj_max_y = ry; }
+	}
+	touch_report(mask, x, y);
+	return true;
+}
+
+static void
+touch_fajita_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	(void)PE_parse_boot_argn("sweetts_xraw", &fj_xraw, sizeof(fj_xraw));
+	(void)PE_parse_boot_argn("sweetts_yraw", &fj_yraw, sizeof(fj_yraw));
+	printf("SWEET TS: fajita RMI4, starting in %u s (raw %dx%d)\n", delay_s, fj_xraw, fj_yraw);
+	touch_wait(delay_s * 1000u);
+
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x80000);
+	st.gpio_e = ml_io_map(FJ_TLMM_EAST, 0x80000);
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.gpio_e || !st.se) {
+		printf("SWEET TS: MMIO mapping failed\n");
+		goto out;
+	}
+	/* VDD on PM8998 ldoa28 (3.008 V); VIO 1.8 V through the gpio88 switch (EAST). */
+	int perr = sweet_rpmh_vreg_enable("ldoa28", 3008);
+	printf("SWEET TS: ldoa28 vote -> %d\n", perr);
+	fj_gpio(st.gpio, tb->sda, 1, 0, 0, false, false);   /* gpio49 qup12 */
+	fj_gpio(st.gpio, tb->scl, 1, 0, 0, false, false);   /* gpio50 qup12 */
+	fj_gpio(st.gpio_e, FJ_GPIO_VIO, 0, 0, 3, true, true);
+	touch_wait(10);
+	fj_gpio(st.gpio_e, FJ_GPIO_ATTN, 0, 3, 3, false, false);  /* input, pull-up */
+	fj_gpio(st.gpio, FJ_GPIO_RESET, 0, 3, 2, true, true);
+	touch_wait(10);
+	fj_gpio(st.gpio, FJ_GPIO_RESET, 0, 3, 2, true, false);    /* reset low */
+	touch_wait(10);
+	fj_gpio(st.gpio, FJ_GPIO_RESET, 0, 3, 2, true, true);
+	touch_wait(200);
+	if (!fajita_clocks() || !touch_se_init()) {
+		goto out;
+	}
+	st.probing = true;
+	bool ok = rmi_pdt() && rmi_f01_init();
+	st.probing = false;
+	if (!ok) {
+		goto out;
+	}
+	printf("SWEET TS: F01 q=%#x d=%#x | F12 q=%#x c=%#x d=%#x\n",
+	    f01_query, f01_data, f12_query, f12_ctrl, f12_data);
+	unsigned errors = 0, ticks = 0;
+	while (!st.dead) {
+		uint8_t status[2] = {0};
+		if (rmi_read(f01_data, status, sizeof(status)) != 0) {
+			if (++errors > 200) {
+				printf("SWEET TS: giving up on the controller\n");
+				break;
+			}
+			touch_wait(10);
+			continue;
+		}
+		errors = 0;
+		if (status[0] & 0x80) {
+			(void)rmi_f01_init();        /* unconfigured -> re-init */
+		}
+		if (status[1] & 0x04) {
+			(void)rmi_frame();
+		} else if (status[1] & 0x01) {
+			touch_report(0, st.x, st.y);
+		}
+		if ((++ticks % 300u) == 0) {
+			printf("SWEET TS: raw max x=%d y=%d irq=%#x\n", fj_max_x, fj_max_y, status[1]);
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
