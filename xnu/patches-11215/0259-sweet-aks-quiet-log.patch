diff --git a/iokit/Kernel/arm/SweetKeyStore.cpp b/iokit/Kernel/arm/SweetKeyStore.cpp
index bb641c8..040c506 100644
--- a/iokit/Kernel/arm/SweetKeyStore.cpp
+++ b/iokit/Kernel/arm/SweetKeyStore.cpp
@@ -21,6 +21,7 @@
 #include <IOKit/IOUserClient.h>
 #include <IOKit/IOKitKeys.h>
 #include <IOKit/IOLib.h>
+#include <pexpert/pexpert.h>
 #include <IOKit/IOMemoryDescriptor.h>
 #include <libkern/c++/OSString.h>
 #include <sys/proc.h>
@@ -311,10 +312,23 @@ AppleKeyStoreUserClient::externalMethod(uint32_t selector, IOExternalMethodArgum
 		break;
 	}
 
-	char name[32];
-	proc_selfname(name, sizeof(name));
-	IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
-	    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	/*
+	 * 0259: one line per keystore call was ~10 lines/s for the whole session (2896 in one log), each a console write,
+	 * a UFS log flush and a USB datagram. Now the first 40 calls and every failure; boot-arg sweetakslog=1 logs all.
+	 */
+	static int aks_log = -1;
+	static uint32_t aks_lines;
+	if (aks_log < 0) {
+		int v = 0;
+		(void)PE_parse_boot_argn("sweetakslog", &v, sizeof(v));
+		aks_log = v != 0;
+	}
+	if (aks_log || ret != kIOReturnSuccess || __atomic_fetch_add(&aks_lines, 1, __ATOMIC_RELAXED) < 40) {
+		char name[32];
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET AKS: %s sel %u arg0 %llu in %u/%u out %u/%u -> 0x%x\n", name, selector,
+		    arg0, in_scalars, in_struct, out_scalars, out_struct, ret);
+	}
 	return ret;
 }
 #endif /* SWEET */
