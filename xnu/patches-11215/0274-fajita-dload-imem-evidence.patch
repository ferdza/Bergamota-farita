diff --git a/bsd/dev/sweet_reboot.c b/bsd/dev/sweet_reboot.c
index ad7e349..0afce78 100644
--- a/bsd/dev/sweet_reboot.c
+++ b/bsd/dev/sweet_reboot.c
@@ -182,13 +182,42 @@ sr_scm_fast(uint32_t fid, uint64_t arginfo, uint64_t a0, uint64_t a1)
 	return sweet_scm_status(x0);
 }
 
+/*
+ * 0274: the IMEM words the downstream crash-dump arming uses (sdm845 imem@146bf000 nodes dload_type@1c, diag_dload@c8, plus
+ * restart_reason@65c). They are logged at init and around the SCM disarm so the next boot log shows which cookie is armed, and
+ * boot-arg sweetdload_imem=1 (default OFF, experiment) also zeroes the two dload words at reset time. Offsets are from the 6T's live
+ * device tree (docs/audit/6T_FACTS.md 3.1); what each value means is not verified.
+ */
+#define SR_IMEM_DLOAD_TYPE 0x1cu
+#define SR_IMEM_DLOAD_NEXT 0x20u
+#define SR_IMEM_DIAG_DLOAD 0xc8u
+static bool sr_dload_imem;
+
+static void
+sr_log_dload_words(const char *when)
+{
+	if (sr_imem == NULL) {
+		return;
+	}
+	printf("SWEET REBOOT: IMEM dload words (%s): [0x1c]=0x%08x [0x20]=0x%08x [0xc8]=0x%08x [0x65c]=0x%08x\n", when,
+	    sr_imem[SR_IMEM_DLOAD_TYPE / 4], sr_imem[SR_IMEM_DLOAD_NEXT / 4], sr_imem[SR_IMEM_DIAG_DLOAD / 4],
+	    sr_imem[SR_IMEM_RESTART / 4]);
+}
+
 /* Download mode off (args 0x10, 0) then SDI off (args 1, 0). A failure only logs: the reset goes on. */
 static void
 sr_crashdump_off(const char *why)
 {
+	sr_log_dload_words(why);
 	int st_dload = sr_scm_fast(SWEET_SCM_FID_DLOAD, 2, SWEET_SCM_BOOT_SET_DLOAD, 0);
 	int st_sdi = sr_scm_fast(SWEET_SCM_FID_SDI, 2, 1, 0);
 	printf("SWEET REBOOT: SCM crashdump off (%s): dload st=%d sdi st=%d\n", why, st_dload, st_sdi);
+	if (sr_dload_imem && sr_imem != NULL) {
+		sr_imem[SR_IMEM_DLOAD_TYPE / 4] = 0;
+		sr_imem[SR_IMEM_DIAG_DLOAD / 4] = 0;
+		__asm__ volatile ("dsb sy" ::: "memory");
+	}
+	sr_log_dload_words("after");
 }
 
 /* Thread context, after the SPMI driver can start. Idempotent. */
@@ -207,7 +236,9 @@ sweet_reboot_init(void)
 		sr_dload = sweet_dload_mode_parse(have, v);
 		uint32_t pf = 0;
 		sr_psci_first = PE_parse_boot_argn("sweetresetpsci", &pf, sizeof(pf)) && pf == 1;
-		printf("SWEET REBOOT: fajita: sweetdload=%d sweetresetpsci=%d\n", sr_dload, sr_psci_first);
+		uint32_t di = 0;
+		sr_dload_imem = PE_parse_boot_argn("sweetdload_imem", &di, sizeof(di)) && di == 1;
+		printf("SWEET REBOOT: fajita: sweetdload=%d sweetresetpsci=%d sweetdload_imem=%d\n", sr_dload, sr_psci_first, sr_dload_imem);
 	}
 	if (PE_parse_boot_argn("sweetreboot", arg, sizeof(arg))) {
 		int mode = sr_parse(arg);
@@ -223,6 +254,9 @@ sweet_reboot_init(void)
 		sr_pon_ready = true;
 	}
 	sr_ready = sr_pshold != NULL;
+	if (sr_fajita) {
+		sr_log_dload_words("boot");
+	}
 	if (sr_fajita && sweet_dload_at_init(sr_dload)) {
 		sr_crashdump_off("init");
 	}
