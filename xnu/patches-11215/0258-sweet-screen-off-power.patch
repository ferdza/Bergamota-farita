 		uint32_t count = dwc_rd(GEVNTCOUNT) & 0xffff;
+		quiet = count ? 0 : (quiet < 1000000 ? quiet + 1 : quiet);
 		if (count) {
 			ud_sync(UD_EVT, UD_EVT_SIZE);
 			for (uint32_t done = 0; done < count; done += 4) {
@@ -1045,7 +1068,7 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 			}
 			dwc_wr(GEVNTCOUNT, count);
 		}
-		if ((++ticks % 30000) == 0) {
+		if ((++ticks % 30000) == 0 && quiet < 50) {
 			volatile uint32_t *rx = (volatile uint32_t *)(ud.dma + UD_TRB_RX);
 			volatile uint32_t *tx = (volatile uint32_t *)(ud.dma + UD_TRB_TX);
 			ud_sync(UD_TRB_RX, 0x20);
@@ -1054,7 +1077,7 @@ ud_thread(void *arg __unused, wait_result_t wr __unused)
 			    ud.rx_frames, ud.tx_frames, ud.configured, ud.data_alt, ud.tx_busy, ud.txq_count,
 			    rx[2], rx[3], ud.xfer_active[EP_RX], tx[2], tx[3], ud.xfer_active[EP_TX], dwc_rd(DSTS));
 		}
-		ud_sleep_ms(1);
