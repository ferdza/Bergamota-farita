+extern int sweet_display_off;           /* sweet_fb.c (0258) */
+
+/*
+ * 0258: the controller's interrupt is masked (polled), and a 1 ms poll forever woke a CPU 1000 times a second with the
+ * phone asleep in a pocket. Now 1 ms while events come (and for 50 ms after the last one, so a burst never waits), then
+ * 4 ms; with the display off and the link idle 20 ms, and 100 ms when no host has configured us (no cable). A transmit
+ * wakes the thread at once (ud_if_output), so only the first received frame after a quiet spell can be late, by at
+ * most the current interval.
+ */
+static uint32_t
+ud_poll_ms(uint32_t quiet)
+{
+	if (quiet < 50) {
+		return 1;
+	}
+	if (!ud.configured) {
+		return 100;
+	}
+	return __atomic_load_n(&sweet_display_off, __ATOMIC_ACQUIRE) ? 20 : 4;
+}
