+/*
+ * Governor v2 window: per CPU busy fraction since the last call (wall and idle in the same mach units). The cluster
+ * value is the busiest CPU (one busy thread must be able to raise a four CPU cluster), the mean is only reported.
+ */
+static void
+cf_cluster_busy(struct cf_domain *d, uint64_t wall, uint32_t *bmax, uint32_t *bavg)
+{
+	uint32_t worst = 0, seen = 0;
+	uint64_t sum = 0;
+
+	for (unsigned k = 0; k < d->ncpu && d->first_cpu + k < cf_ncpus; k++) {
+		uint64_t idle = sweet_processor_idle_time((int)(d->first_cpu + k));
+		if (idle == ~0ULL) {
+			continue;
+		}
+		uint32_t busy = cg_busy(wall, idle - d->prev_idle[k]);
+		d->prev_idle[k] = idle;
+		sum += busy;
+		seen++;
+		if (busy > worst) {
+			worst = busy;
+		}
+	}
+	*bmax = worst;
+	*bavg = seen ? (uint32_t)(sum / seen) : 0;
+}
+
+static void
+cf_gov2_step(unsigned id, struct cf_domain *d, uint64_t wall, uint64_t now_ns)
+{
+	uint32_t cur = cf_rd(d, CPUFREQ_PERF_STATE);
+	if (cur >= d->n) {
+		cur = d->req < d->n ? d->req : 0;
+	}
+	uint32_t bmax, bavg;
+	cf_cluster_busy(d, wall, &bmax, &bavg);
+	uint32_t start = d->g2_win_idx < d->n ? d->g2_win_idx : cur;
+	uint32_t inv = cg_inv_util(bmax, cg_avg_khz(d->khz[start], d->khz[cur]), d->khz[d->top]);
+	uint32_t inv_eff = inv > d->g2_prev_inv ? inv : d->g2_prev_inv;     /* a frame period of memory */
+	d->g2_prev_inv = inv;
+	d->g2_busy_max = bmax;
+	d->g2_busy_avg = bavg;
+	d->g2_inv = inv;
+	d->load = (bmax * 100 + CG_SCALE / 2) / CG_SCALE;
+	if (cf_mode != MODE_GOV) {
+		d->g2_win_idx = cur;
+		return;
+	}
+	/* Touch boost (patch 0217): the floor is in_idx while the hold runs, the ceiling at least that. */
+	bool in_act = cf_in_khz && mach_absolute_time() < cf_in_until;
+	uint32_t hi = d->eff_cap, lo = 0;
+	if (in_act && d->in_idx > hi) {
+		hi = d->in_idx;
+	}
+	if (in_act) {
+		lo = d->in_idx;
+	}
+	d->in_on = in_act;
+	if (cf_offcap && __atomic_load_n(&sweet_display_off, __ATOMIC_ACQUIRE)) {
+		uint64_t five;
+		nanoseconds_to_absolutetime(5 * NSEC_PER_SEC, &five);
+		uint64_t now = mach_absolute_time();
+		if (cf_off_since == 0) {
+			cf_off_since = now;
+		}
+		if (now - cf_off_since >= five && !in_act) {
+			if (cur != 0) {
+				cf_request(d, 0);       /* 0258: display off, lowest state */
+			}
+			d->g2_win_idx = 0;
+			return;
+		}
+	} else if (id == 1) {
+		cf_off_since = 0;
+	}
+	if (cur > hi) {                         /* a lowered ceiling applies at once */
+		cf_request(d, hi);
+		d->g2_downs++;
+		cur = hi;
+	}
+	uint32_t tgt = cg_target_idx(d->khz, d->n, lo, hi, bmax, inv_eff, cf_g2_headroom,
+	    (cf_g2_go_pct * CG_SCALE) / 100, d->g2_hispeed);
+	uint32_t next = cg_step(cur, tgt, now_ns, &d->g2_last_ge_ns, d->g2_last_change_ns, 0,
+	    (uint64_t)cf_g2_down_ms * NSEC_PER_MSEC);
+	if (next != cur) {
+		if (next > cur) {
+			d->g2_ups++;
+		} else {
+			d->g2_downs++;
+		}
+		cf_request(d, next);
+		d->g2_last_change_ns = now_ns;
+		cur = next;
+	} else if (tgt < cur) {
+		d->g2_holds++;
+	}
+	d->g2_win_idx = cur;
+}
