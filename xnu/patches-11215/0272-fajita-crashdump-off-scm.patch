+/*
+ * OnePlus 6T (fajita) crash-dump disarm (AUDIT_BOOT_CHAIN F-01 / AUDIT_KERNEL_DRIVERS F-03). The OnePlus ABL arms
+ * Qualcomm CrashDump and nothing in XNU ever cleared it, so every reset ends in CrashDump (INFERRED, not yet
+ * proven on the phone). Linux qcom_scm and the downstream msm-poweroff clear it with two SCM calls before a restart;
+ * we do the same (sweet_scm_logic.h). Boot-args, fajita only:
+ *   sweetdload=0|1|2  0 = no SCM call (old behaviour), 1 = at restart/poweroff/panic (default), 2 = also at init
+ *   sweetresetpsci=1  restart tries PSCI SYSTEM_RESET before PS_HOLD (experiment, default off: an earlier
+ *                     unconditional version of this reorder panicked, cause unknown)
+ */
+static bool sr_fajita;
+static int sr_dload = SWEET_DLOAD_OFF;
+static bool sr_psci_first;
+static bool sr_scm_panic_done;
 
 static const char *
 sr_name(int mode)
@@ -147,6 +161,36 @@ sr_psci_system_reset(void)
 	    "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
 }
 
+/*
+ * One SCM fast call (SMC64, owner SIP, registers only: x0 fid, x1 arginfo, x2..x5 args, x6 = x7 = 0).
+ * Lock-less and allocation-free, so it is safe at reset time and in a panic. Returns the SCM status (0 = ok).
+ */
+static int
+sr_scm_fast(uint32_t fid, uint64_t arginfo, uint64_t a0, uint64_t a1)
+{
+	register uint64_t x0 __asm__("x0") = fid;
+	register uint64_t x1 __asm__("x1") = arginfo;
+	register uint64_t x2 __asm__("x2") = a0;
+	register uint64_t x3 __asm__("x3") = a1;
+	register uint64_t x4 __asm__("x4") = 0;
+	register uint64_t x5 __asm__("x5") = 0;
+	register uint64_t x6 __asm__("x6") = 0;
+	register uint64_t x7 __asm__("x7") = 0;
+	__asm__ volatile ("smc #0"
+	    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+	    : : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "cc", "memory");
+	return sweet_scm_status(x0);
+}
+
+/* Download mode off (args 0x10, 0) then SDI off (args 1, 0). A failure only logs: the reset goes on. */
+static void
+sr_crashdump_off(const char *why)
+{
+	int st_dload = sr_scm_fast(SWEET_SCM_FID_DLOAD, 2, SWEET_SCM_BOOT_SET_DLOAD, 0);
+	int st_sdi = sr_scm_fast(SWEET_SCM_FID_SDI, 2, 1, 0);
+	printf("SWEET REBOOT: SCM crashdump off (%s): dload st=%d sdi st=%d\n", why, st_dload, st_sdi);
+}
+
 /* Thread context, after the SPMI driver can start. Idempotent. */
