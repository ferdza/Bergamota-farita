+		sr_psci_first = PE_parse_boot_argn("sweetresetpsci", &pf, sizeof(pf)) && pf == 1;
+		printf("SWEET REBOOT: fajita: sweetdload=%d sweetresetpsci=%d\n", sr_dload, sr_psci_first);
+	}
 	if (PE_parse_boot_argn("sweetreboot", arg, sizeof(arg))) {
 		int mode = sr_parse(arg);
 		if (mode < 0) {
@@ -170,6 +223,9 @@ sweet_reboot_init(void)
 		sr_pon_ready = true;
 	}
 	sr_ready = sr_pshold != NULL;
+	if (sr_fajita && sweet_dload_at_init(sr_dload)) {
+		sr_crashdump_off("init");
+	}
 	printf("SWEET REBOOT: boot-arg mode %s, PS_HOLD %s, IMEM %s, PON spare write %s\n",
 	    sr_name(sr_bootarg), sr_pshold ? "mapped" : "NOT mapped",
 	    sr_imem ? "mapped" : "NOT mapped", sr_pon_ready ? "ready" : "unavailable");
@@ -210,6 +266,11 @@ void
 sweet_reboot_note_panic(void)
 {
 	sr_in_panic = true;
+	/* a hung panic that a watchdog resets later must not land in CrashDump either (once; fast call, no locks) */
+	if (sr_fajita && sweet_dload_at_reset(sr_dload) && !sr_scm_panic_done) {
+		sr_scm_panic_done = true;
+		sr_crashdump_off("panic");
+	}
 }
 
 /*
@@ -230,6 +291,9 @@ sweet_reboot_poweroff(void)
 		sr_imem[SR_IMEM_RESTART / 4] = 0;
 		__asm__ volatile ("dsb sy" ::: "memory");
 	}
+	if (sr_fajita && sweet_dload_at_reset(sr_dload)) {
+		sr_crashdump_off("poweroff");
+	}
 	printf("SWEET REBOOT: requesting PSCI SYSTEM_OFF\n");
 	__asm__ volatile ("dsb sy" ::: "memory");
 	sr_psci_system_off();
@@ -286,12 +350,27 @@ sweet_reboot_restart(int panic_restart)
 		printf("SWEET REBOOT: IMEM restart_reason 0x146bf65c = 0x%08x\n", magic);
 	}
 	__asm__ volatile ("dsb sy" ::: "memory");
-	*sr_pshold = 0;
-	__asm__ volatile ("dsb sy" ::: "memory");
-	delay(2000 * 1000);
-	printf("SWEET REBOOT: PS_HOLD did not reset, PSCI SYSTEM_RESET\n");
-	sr_psci_system_reset();
-	delay(2000 * 1000);
+	if (sr_fajita && sweet_dload_at_reset(sr_dload)) {
+		sr_crashdump_off("restart");
+	}
+	/* PS_HOLD, then PSCI SYSTEM_RESET (old order); sweetresetpsci=1 on fajita swaps them (experiment) */
+	int steps[2];
+	sweet_reset_order(sr_fajita && sr_psci_first, steps);
+	for (int i = 0; i < 2; i++) {
+		if (steps[i] == SWEET_RESET_PSHOLD) {
+			*sr_pshold = 0;
+			__asm__ volatile ("dsb sy" ::: "memory");
+		} else {
+			if (i == 1) {
+				printf("SWEET REBOOT: PS_HOLD did not reset, PSCI SYSTEM_RESET\n");
+			}
+			sr_psci_system_reset();
+		}
+		delay(2000 * 1000);
+		if (i == 0 && steps[0] == SWEET_RESET_PSCI) {
+			printf("SWEET REBOOT: PSCI SYSTEM_RESET did not reset, PS_HOLD\n");
+		}
+	}
 	return -1;
 }
