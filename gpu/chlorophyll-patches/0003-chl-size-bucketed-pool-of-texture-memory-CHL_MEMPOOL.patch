diff --git a/test/chl_mempool_test.c b/test/chl_mempool_test.c
new file mode 100644
index 0000000..3fb3363
--- /dev/null
+++ b/test/chl_mempool_test.c
@@ -0,0 +1,88 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Host test of air/chl_mempool.h (no GPU, no Mesa): cc -O1 -Wall -I air test/chl_mempool_test.c -o /tmp/chl_mempool_test -lpthread */
+#include <assert.h>
+#include <stdio.h>
+#include <unistd.h>
+#include "chl_mempool.h"
+
+static unsigned freed;
+static uint64_t freed_mem[256];
+static void
+fr(const void *owner, uint64_t mem)
+{
+   (void)owner;
+   freed_mem[freed++ & 255] = mem;
+}
+
+#define MB (1ull << 20)
+
+int
+main(void)
+{
+   /* buckets: monotonic, >= size, waste <= 1/8 (+ the 64 KB floor) */
+   for (uint64_t s = 1; s < (1ull << 33); s = s * 3 / 2 + 1) {
+      uint64_t b = chl_mempool_bucket(s);
+      assert(b >= s);
+      assert(b - s <= s / 8 + CHL_MEMPOOL_MIN_STEP);
+      assert(chl_mempool_bucket(b) == b);
+   }
+   /* a 828x1792 RGBA16F target and one a few rows shorter land in one bucket */
+   uint64_t a = 828ull * 1792 * 8, b = 828ull * 1780 * 8;
+   assert(chl_mempool_bucket(a) == chl_mempool_bucket(b));
+
+   static struct chl_mempool p = CHL_MEMPOOL_INIT;
+   int dev1, dev2;
+   assert(!chl_mempool_enabled(&p) || p.cap == 0);   /* off without CHL_MEMPOOL_MB */
+   chl_mempool_configure(&p, 128 * MB, 200ll * 1000000);
+   assert(chl_mempool_enabled(&p));
+
+   uint64_t m, sz;
+   assert(!chl_mempool_take(&p, &dev1, 10 * MB, &m, &sz, fr));   /* empty: miss */
+   assert(p.misses == 1);
+   assert(chl_mempool_put(&p, &dev1, 0x1000, chl_mempool_bucket(10 * MB), fr));
+   assert(!chl_mempool_take(&p, &dev2, 10 * MB, &m, &sz, fr));   /* another device's block is never taken */
+   assert(!chl_mempool_take(&p, &dev1, 20 * MB, &m, &sz, fr));   /* too small */
+   assert(chl_mempool_take(&p, &dev1, 9 * MB, &m, &sz, fr));     /* big enough, not 25 % over */
+   assert(m == 0x1000 && sz == chl_mempool_bucket(10 * MB) && p.bytes == 0);
+   assert(!chl_mempool_take(&p, &dev1, 9 * MB, &m, &sz, fr));    /* it was taken */
+   assert(chl_mempool_put(&p, &dev1, 0x2000, 20 * MB, fr));
+   assert(!chl_mempool_take(&p, &dev1, 4 * MB, &m, &sz, fr));    /* 20 MB for a 4 MB need: more than 25 % over */
+
+   /* smallest fit wins */
+   assert(chl_mempool_put(&p, &dev1, 0x3000, 6 * MB, fr));
+   assert(chl_mempool_put(&p, &dev1, 0x3001, 5 * MB, fr));
+   assert(chl_mempool_take(&p, &dev1, 4 * MB + 1, &m, &sz, fr) && m == 0x3001);
+
+   /* a block above cap/4 is refused; the cap evicts the oldest */
+   assert(!chl_mempool_put(&p, &dev1, 0x4000, 33 * MB, fr));
+   chl_mempool_drain(&p, NULL, fr);
+   assert(p.bytes == 0);
+   freed = 0;
+   for (uint64_t i = 0; i < 8; i++) {
+      assert(chl_mempool_put(&p, &dev1, 0x5000 + i, 32 * MB, fr));
+      usleep(1000);
+   }
+   assert(p.bytes <= 128 * MB);
+   assert(freed == 4 && freed_mem[0] == 0x5000);   /* 8 x 32 MB into a 128 MB cap: the four oldest went */
+
+   /* entries expire */
+   usleep(250000);
+   assert(!chl_mempool_take(&p, &dev1, 32 * MB, &m, &sz, fr));
+   assert(p.bytes == 0 && freed == 8);
+
+   /* slots are bounded */
+   chl_mempool_configure(&p, 1ull << 40, 10ll * 1000000000);
+   for (uint64_t i = 0; i < 3 * CHL_MEMPOOL_SLOTS; i++)
+      chl_mempool_put(&p, &dev2, 0x9000 + i, 1 * MB, fr);
+   unsigned held = 0;
+   for (unsigned k = 0; k < CHL_MEMPOOL_SLOTS; k++)
+      held += p.e[k].mem != 0;
+   assert(held == CHL_MEMPOOL_SLOTS);
+   chl_mempool_drain(&p, &dev1, fr);   /* another owner: nothing goes */
+   assert(p.bytes == CHL_MEMPOOL_SLOTS * MB);
+   chl_mempool_drain(&p, &dev2, fr);
+   assert(p.bytes == 0);
+   printf("chl_mempool_test: ok (hits %llu, misses %llu, puts %llu)\n", (unsigned long long)p.hits, (unsigned long long)p.misses,
+          (unsigned long long)p.puts);
+   return 0;
+}
