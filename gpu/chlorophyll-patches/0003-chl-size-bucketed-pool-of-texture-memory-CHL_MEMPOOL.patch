+/* memory blocks of destroyed textures, by size bucket (chl_mempool.h); off unless CHL_MEMPOOL_MB is set */
+static struct chl_mempool tex_mempool = CHL_MEMPOOL_INIT;
 #define ST_ALLOC(bytes)                                                                  \
    do {                                                                                  \
       atomic_fetch_add_explicit(&st_mem_allocs, 1, memory_order_relaxed);                \
@@ -422,6 +426,26 @@ chl_get_stats(struct chl_stats *out)
