diff --git a/air/chl_mempool.h b/air/chl_mempool.h
new file mode 100644
index 0000000..75d412f
--- /dev/null
+++ b/air/chl_mempool.h
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Chlorophyll: a pool of device memory blocks (the VkDeviceMemory of destroyed textures), kept by size bucket.
+ *
+ * CoreAnimation sizes its offscreen targets to the layer extent, which moves every frame, so a pool keyed by the exact
+ * texture shape hits only 30-45 % of the time (NOTES: "texpool"). The expensive part of making a texture is the kernel's
+ * BO (vkAllocateMemory); the VkImage and its views are plain userland objects. So the pool keeps the MEMORY: a new image
+ * of a different shape binds a block that is big enough (and not much bigger) at offset 0. Vulkan allows binding an image
+ * to memory that held another image (its initial layout is UNDEFINED, which is what transition_new_image records).
+ *
+ * Blocks are allocated rounded up to a bucket (1/8 of the size's power of two, at least 64 KB), so shapes that differ by a
+ * few rows or columns share blocks. A take accepts a block up to 25 % + 64 KB over the need.
+ *
+ * Plain C over opaque 64-bit handles, so it is unit-tested on a host (test/chl_mempool_test.c). Re-implemented from the
+ * idea of size-bucketed BO caches (freedreno's fd_bo_cache buckets BOs by power-of-two eighths); no code copied.
+ * Off unless CHL_MEMPOOL_MB is set (the inject sets it for backboardd, like BGMTL_TEXPOOL_MB); CHL_MEMPOOL_AGE_MS (5000).
+ */
+#ifndef CHL_MEMPOOL_H
+#define CHL_MEMPOOL_H
+
+#include <pthread.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <time.h>
+
+#define CHL_MEMPOOL_SLOTS 96
+#define CHL_MEMPOOL_MIN_STEP (64u << 10)
+
+struct chl_mempool_ent {
+   uint64_t mem;     /* 0: free slot */
+   uint64_t size;
+   int64_t t;        /* when it was put */
+   const void *owner;
+};
+
+struct chl_mempool {
+   pthread_mutex_t lock;
+   bool configured;
+   uint64_t cap;     /* bytes; 0 = off */
+   int64_t age_ns;
+   uint64_t bytes;   /* held */
+   uint64_t hits, misses, puts;
+   struct chl_mempool_ent e[CHL_MEMPOOL_SLOTS];
+};
+
+#define CHL_MEMPOOL_INIT { PTHREAD_MUTEX_INITIALIZER, false, 0, 0, 0, 0, 0, 0, { { 0, 0, 0, NULL } } }
+
+/* frees one block; owner is the one it was put with */
+typedef void (*chl_mempool_free_fn)(const void *owner, uint64_t mem);
+struct chl_mempool_victim {
+   const void *owner;
+   uint64_t mem;
+};
+
+static inline int64_t
+chl_mempool_now(void)
+{
+   struct timespec ts;
+   clock_gettime(CLOCK_MONOTONIC, &ts);
+   return (int64_t)ts.tv_sec * 1000000000ll + ts.tv_nsec;
+}
+
+/* the size a block is allocated at for a need of `size` bytes */
+static inline uint64_t
+chl_mempool_bucket(uint64_t size)
+{
+   uint64_t p = 1;
+   while (p < size && p < (1ull << 62))
+      p <<= 1;
+   /* size in (p/2, p]: eight steps per power of two */
+   uint64_t step = p >> 4;
+   if (step < CHL_MEMPOOL_MIN_STEP)
+      step = CHL_MEMPOOL_MIN_STEP;
+   return (size + step - 1) / step * step;
+}
+
+/* cap in bytes (0 = off), age in ns; callable again to change them */
+static inline void
+chl_mempool_configure(struct chl_mempool *p, uint64_t cap, int64_t age_ns)
+{
+   pthread_mutex_lock(&p->lock);
+   p->cap = cap;
+   p->age_ns = age_ns;
+   p->configured = true;
+   pthread_mutex_unlock(&p->lock);
+}
+
+static inline void
+chl_mempool_configure_env(struct chl_mempool *p)
+{
+   if (p->configured)
+      return;
+   const char *mb = getenv("CHL_MEMPOOL_MB"), *age = getenv("CHL_MEMPOOL_AGE_MS");
+   chl_mempool_configure(p, mb ? (uint64_t)atol(mb) << 20 : 0, (age ? atol(age) : 5000) * 1000000ll);
+}
+
+static inline bool
+chl_mempool_enabled(struct chl_mempool *p)
+{
+   chl_mempool_configure_env(p);
+   return p->cap != 0;
+}
+
+/* under the lock: move slot k to the victims list */
+static inline void
+chl_mempool_evict_locked(struct chl_mempool *p, unsigned k, struct chl_mempool_victim *victims, unsigned *nv)
+{
+   victims[(*nv)++] = (struct chl_mempool_victim){ p->e[k].owner, p->e[k].mem };
+   p->bytes -= p->e[k].size;
+   p->e[k].mem = 0;
+}
+
+static inline void
+chl_mempool_expire_locked(struct chl_mempool *p, int64_t now, struct chl_mempool_victim *victims, unsigned *nv)
+{
+   for (unsigned k = 0; k < CHL_MEMPOOL_SLOTS; k++)
+      if (p->e[k].mem && now - p->e[k].t > p->age_ns)
+         chl_mempool_evict_locked(p, k, victims, nv);
+}
+
+/* A held block of `owner` for a need of `need` bytes: the smallest that is big enough and at most 25 % + 64 KB too big. */
+static inline bool
+chl_mempool_take(struct chl_mempool *p, const void *owner, uint64_t need, uint64_t *mem, uint64_t *size, chl_mempool_free_fn fr)
+{
+   if (!chl_mempool_enabled(p))
+      return false;
+   struct chl_mempool_victim victims[CHL_MEMPOOL_SLOTS];
+   unsigned nv = 0;
+   bool got = false;
+   pthread_mutex_lock(&p->lock);
+   chl_mempool_expire_locked(p, chl_mempool_now(), victims, &nv);
+   int best = -1;
+   uint64_t limit = need + need / 4 + CHL_MEMPOOL_MIN_STEP;
+   for (unsigned k = 0; k < CHL_MEMPOOL_SLOTS; k++)
+      if (p->e[k].mem && p->e[k].owner == owner && p->e[k].size >= need && p->e[k].size <= limit &&
+          (best < 0 || p->e[k].size < p->e[best].size))
+         best = (int)k;
+   if (best >= 0) {
+      *mem = p->e[best].mem;
+      *size = p->e[best].size;
+      p->bytes -= p->e[best].size;
+      p->e[best].mem = 0;
+      p->hits++;
+      got = true;
+   } else {
+      p->misses++;
+   }
+   pthread_mutex_unlock(&p->lock);
+   for (unsigned i = 0; i < nv; i++)
+      fr(victims[i].owner, victims[i].mem);
+   return got;
+}
+
+/* Keep a block (size = what it was allocated with). false: the caller frees it. Oldest blocks make room. */
+static inline bool
+chl_mempool_put(struct chl_mempool *p, const void *owner, uint64_t mem, uint64_t size, chl_mempool_free_fn fr)
+{
+   if (!chl_mempool_enabled(p) || size > p->cap / 4)
+      return false;
+   struct chl_mempool_victim victims[CHL_MEMPOOL_SLOTS];
+   unsigned nv = 0;
+   bool kept = false;
+   pthread_mutex_lock(&p->lock);
+   int64_t now = chl_mempool_now();
+   chl_mempool_expire_locked(p, now, victims, &nv);
+   for (;;) {
+      int free_k = -1, old_k = -1;
+      for (unsigned k = 0; k < CHL_MEMPOOL_SLOTS; k++) {
+         if (!p->e[k].mem) {
+            if (free_k < 0)
+               free_k = (int)k;
+         } else if (old_k < 0 || p->e[k].t < p->e[old_k].t) {
+            old_k = (int)k;
+         }
+      }
+      if (free_k >= 0 && p->bytes + size <= p->cap) {
+         p->e[free_k] = (struct chl_mempool_ent){ mem, size, now, owner };
+         p->bytes += size;
+         p->puts++;
+         kept = true;
+         break;
+      }
+      if (old_k < 0)
+         break;
+      chl_mempool_evict_locked(p, (unsigned)old_k, victims, &nv);
+   }
+   pthread_mutex_unlock(&p->lock);
+   for (unsigned i = 0; i < nv; i++)
+      fr(victims[i].owner, victims[i].mem);
+   return kept;
+}
+
+/* Free every held block of `owner` (NULL: of every owner). */
+static inline void
+chl_mempool_drain(struct chl_mempool *p, const void *owner, chl_mempool_free_fn fr)
+{
+   struct chl_mempool_victim victims[CHL_MEMPOOL_SLOTS];
+   unsigned nv = 0;
+   pthread_mutex_lock(&p->lock);
+   for (unsigned k = 0; k < CHL_MEMPOOL_SLOTS; k++)
+      if (p->e[k].mem && (!owner || p->e[k].owner == owner))
+         chl_mempool_evict_locked(p, k, victims, &nv);
+   pthread_mutex_unlock(&p->lock);
+   for (unsigned i = 0; i < nv; i++)
+      fr(victims[i].owner, victims[i].mem);
+}
+
+#endif
