+   pthread_mutex_unlock(&tex_mempool.lock);
+}
+
+static void
+mempool_free(const void *owner, uint64_t mem)
+{
+   const struct chl_device *d = owner;
+   d->vk.vkFreeMemory(d->dev, (VkDeviceMemory)(uintptr_t)mem, NULL);
+   ST_FREE();
+}
+
+/* give every pooled block back to the kernel (the idle trim) */
+void
+chl_trim(void)
+{
+   chl_mempool_drain(&tex_mempool, NULL, mempool_free);
 }
 
 /* ---------------------------------------------------------------------------------------------------------------------
@@ -822,6 +846,7 @@ chl_device_close(struct chl_device *d)
    pthread_mutex_unlock(&d->done_lock);
    pthread_join(d->thread, NULL);
