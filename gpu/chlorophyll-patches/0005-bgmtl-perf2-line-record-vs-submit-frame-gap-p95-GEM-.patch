+                  (unsigned long long)(st.pool_hits - st_prev.pool_hits), (unsigned long long)(st.pool_misses - st_prev.pool_misses),
+                  st.pool_held_bytes / 1048576.0);
+         bgmtl_note_line(line);
+         st_prev = st;
+         gaps.n = 0;
