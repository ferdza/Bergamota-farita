       if (bg_texpool_cap()) {
          snprintf(line, sizeof(line), "texpool: %lu hits, %lu misses, %.1f MB held", g_texpool_hits, g_texpool_misses,
                   g_texpool_bytes / 1048576.0);
@@ -1824,7 +1861,9 @@ static void
