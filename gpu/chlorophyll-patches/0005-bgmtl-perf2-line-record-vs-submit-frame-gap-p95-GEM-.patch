diff --git a/test/bg_perfstat_test.c b/test/bg_perfstat_test.c
new file mode 100644
index 0000000..7694aa3
--- /dev/null
+++ b/test/bg_perfstat_test.c
@@ -0,0 +1,24 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* cc -O1 -Wall -I src test/bg_perfstat_test.c -o /tmp/bg_perfstat_test */
+#include <assert.h>
+#include <stdio.h>
+#include "bg_perfstat.h"
+
+int
+main(void)
+{
+   struct bg_samples s = { 0 };
+   assert(bg_samples_pct(&s, 95) == 0);
+   for (uint64_t i = 100; i >= 1; i--) bg_samples_add(&s, i);   // 1..100, added backwards
+   assert(bg_samples_pct(&s, 95) == 95);
+   assert(bg_samples_pct(&s, 50) == 50);
+   assert(bg_samples_pct(&s, 100) == 100);
+   assert(bg_samples_pct(&s, 1) == 1);
+   s.n = 0;
+   bg_samples_add(&s, 7);
+   assert(bg_samples_pct(&s, 95) == 7);
+   for (unsigned i = 0; i < 2 * BG_PERF_SAMPLES; i++) bg_samples_add(&s, i);
+   assert(s.n == BG_PERF_SAMPLES);
+   printf("bg_perfstat_test: ok\n");
+   return 0;
+}
