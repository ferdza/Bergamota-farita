       snprintf(line, sizeof(line), "perf: %.1f cbuf/s, %.1f draws/cbuf; per second: encode %.0f ms, submit %.0f ms, gpu wait %.0f ms, "
                "between %.0f ms; max encode %.1f ms, max wait %.1f ms", n / sec, n ? (double)draws / n : 0, enc / 1e6 / sec,
@@ -1626,6 +1638,31 @@ bg_perf_note(uint64_t t_first, uint64_t t_begin, uint64_t t_flushed, uint64_t t_
                   (unsigned long long)bin[0], (unsigned long long)bin[1], (unsigned long long)bin[2], (unsigned long long)bin[3]);
          bgmtl_note_line(line);
       }
+      {
+         // where a frame's CPU time goes. "record" = time inside this library's calls (draw incl. chl's state flush and Turnip's
+         // vkCmd*, texture binds, setBytes, pass begin) against "encode" (first encoder to commit, which also holds CoreAnimation's
+         // own work between calls). There is no deferred replay in this runtime: commands go straight into the VkCommandBuffer,
+         // so "submit" (vkQueueSubmit path in commit) is the whole replay cost. BOs: vkAllocateMemory calls (each a GEM BO) and
+         // VkImages per command buffer in the window, and the bucketed memory pool's hits and misses (CHL_MEMPOOL_MB).
+         uint64_t lib[4];
+         for (int i = 0; i < 4; i++) lib[i] = __atomic_exchange_n(&g_bg_lib_ns[i], 0, __ATOMIC_RELAXED);
+         struct chl_stats st;
