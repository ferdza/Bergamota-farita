diff --git a/src/bg_perfstat.h b/src/bg_perfstat.h
new file mode 100644
index 0000000..865149c
--- /dev/null
+++ b/src/bg_perfstat.h
@@ -0,0 +1,39 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Plain-C helpers of the perf line (bgmtl.m), kept apart so a host can test them (test/bg_perfstat_test.c). */
+#ifndef BG_PERFSTAT_H
+#define BG_PERFSTAT_H
+
+#include <stdint.h>
+#include <stdlib.h>
+
+#define BG_PERF_SAMPLES 512
+
+struct bg_samples {
+   uint64_t v[BG_PERF_SAMPLES];
+   unsigned n;
+};
+
+static inline void
+bg_samples_add(struct bg_samples *s, uint64_t x)
+{
+   if (s->n < BG_PERF_SAMPLES) s->v[s->n++] = x;   // a window longer than 512 commits keeps its first 512
+}
+
+static int
+bg_samples_cmp(const void *a, const void *b)
+{
+   uint64_t x = *(const uint64_t *)a, y = *(const uint64_t *)b;
+   return x < y ? -1 : x > y;
+}
+
+// the p-th percentile (0..100, nearest rank) of what was added; 0 when empty. Sorts in place.
+static inline uint64_t
+bg_samples_pct(struct bg_samples *s, unsigned p)
+{
+   if (!s->n) return 0;
+   qsort(s->v, s->n, sizeof(s->v[0]), bg_samples_cmp);
+   unsigned rank = (p * s->n + 99) / 100;   // ceil(p/100 * n)
+   return s->v[(rank ? rank : 1) - 1];
+}
+
+#endif
